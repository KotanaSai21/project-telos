# Copy to .env and fill in. Never commit .env.
# The API fails fast at startup if a required variable is missing.

# --- Provider selection ---
# local   : no network. Verdicts come from committed fixtures. Demo-safe.
# gemini  : AI Studio API key. Subject to free-tier eligibility or Developer API billing.
# vertex  : full Google Cloud. Needs a project and application-default credentials.
PROJECT_TELOS_PROVIDER=local
# Applies to profiles, creator checks, YouTube audits, reframing, and Imagen.
# Explicit selection only: no automatic failover or unexpected cross-provider charges.
# GEMINI_API_KEY is ignored by AI calls when vertex is selected.

# Required when PROJECT_TELOS_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Official YouTube discovery after consent. Enable YouTube Data API v3 in your
# Google Cloud project; restrict this server-side key to that API.
# Search does not analyse a video. Selected public videos use Gemini separately.
YOUTUBE_API_KEY=

# --- Required when PROJECT_TELOS_PROVIDER=vertex (no media bucket required) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Enable Vertex AI API and grant the runtime identity Vertex AI User.
# Locally: gcloud auth application-default login
# On Cloud Run: use an attached service account, not a downloaded key.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Storage ---
# local     : JSON files under PROJECT_TELOS_LOCAL_DATA_DIR (default).
# firestore : profiles, sessions, receipts, analyses in Firestore. Needs GOOGLE_CLOUD_PROJECT
#             and `pip install -e "services/api[cloud]"`.
PROJECT_TELOS_STORAGE=local
PROJECT_TELOS_FIRESTORE_DATABASE=(default)
PROJECT_TELOS_LOCAL_DATA_DIR=.local/data
PROJECT_TELOS_LOCAL_MEDIA_DIR=.local/media
PROJECT_TELOS_MEDIA_BUCKET=

# --- Optional Google Cloud integrations (need GOOGLE_CLOUD_PROJECT) ---
# Content-free verdict rows streamed to <dataset>.verdicts (created on first write).
PROJECT_TELOS_BIGQUERY_ENABLED=false
PROJECT_TELOS_BIGQUERY_DATASET=project_telos_analytics
# Translate non-English ThumbnailTruth drafts with Cloud Translation v3 before scanning.
PROJECT_TELOS_TRANSLATION_ENABLED=false

# Serve the built web app (apps/web/dist) from the API. Set in the Docker image.
PROJECT_TELOS_WEB_DIST=

# --- Models ---
# Choose a model available in the selected provider and GOOGLE_CLOUD_LOCATION.
# Developer API model availability does not imply Vertex availability.
PROJECT_TELOS_GEMINI_MODEL=gemini-2.5-flash
PROJECT_TELOS_GEMINI_REASONING_MODEL=gemini-2.5-pro
# Imagen honest-thumbnail redesign; via an API key it needs a billing-enabled key.
PROJECT_TELOS_IMAGEN_MODEL=imagen-4.0-generate-001
PROJECT_TELOS_EMBEDDING_MODEL=text-embedding-005

# --- Runtime ---
PROJECT_TELOS_ENV=development
PROJECT_TELOS_LOG_LEVEL=INFO
PROJECT_TELOS_ALLOWED_ORIGINS=http://localhost:5173
PROJECT_TELOS_RATE_LIMIT_PER_MINUTE=60

# Serve precomputed verdicts only; never call a model at request time.
# Set true when recording the demo (task T9.3).
PROJECT_TELOS_OFFLINE_FALLBACK=false

# --- Access code ---
# When set, the site asks for this code before showing anything, and the API
# refuses requests without it. Leave empty for an open site. Case and
# spaces are ignored. On Cloud Run, store it in Secret Manager.
PROJECT_TELOS_ACCESS_CODE=ChinnadlerBong
# One line shown under the code box. Set ENABLED=false to hide it.
PROJECT_TELOS_ACCESS_HINT=Every week, the TV Guide comes to Chandler and Joey’s apartment. What name appears on the address label?
PROJECT_TELOS_ACCESS_HINT_ENABLED=true
