{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-telos.dev/schemas/decision.json",
  "title": "Decision",
  "description": "What to do about one asset for one profile. Personal; never shared or cached across viewers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assetHash", "profileId", "action", "affectedRanges", "reason", "confidence", "createdAt"],
  "properties": {
    "assetHash": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
    "profileId": { "type": "string", "minLength": 1 },
    "action": { "$ref": "#/$defs/action" },
    "affectedRanges": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/range" }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Plain-language explanation shown to the viewer. Never asserts a legal determination."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "alternatives": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/action" },
      "description": "Less and more restrictive actions that were considered."
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "action": {
      "type": "string",
      "enum": ["allow", "soften", "summarize", "reframe", "replace", "hold", "quarantine"],
      "description": "Ordered least to most restrictive. Selection always prefers the least restrictive effective action."
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSec", "endSec"],
      "properties": {
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "minimum": 0 }
      }
    }
  }
}
