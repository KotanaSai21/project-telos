{
  "name": "@project-telos/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for Project Telos data contracts. JSON Schema in, TypeScript and Pydantic out.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
